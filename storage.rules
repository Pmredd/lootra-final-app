rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Checks if the user is a Super Admin using Firestore reference
    function isSuperAdmin() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == "super_admin" &&
             firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }

    // --- Reels TV Video and Thumbnail Uploads ---
    match /reels/videos/{allPaths=**} {
      // Authenticated users should have read-only access to published reel media.
      allow read: if request.auth != null;
      // Only Super Admins can upload, update or delete
      allow write: if isSuperAdmin();
    }

    match /reels/thumbnails/{allPaths=**} {
      // Authenticated users should have read-only access to published reel media.
      allow read: if request.auth != null;
      // Only Super Admins can upload, update or delete
      allow write: if isSuperAdmin();
    }

    match /reels/{reelId}/{allPaths=**} {
      // Authenticated users should have read-only access to published reel media.
      allow read: if request.auth != null;
      // Only Super Admins can upload, update or delete
      allow write: if isSuperAdmin();
    }

    // --- Profile Images ---
    match /profiles/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // --- General Fallback Security Rule ---
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
  }
}
